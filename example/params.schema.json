{
  "$defs": {
    "parameter": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "values": {
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              },
              "values": {
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              },
              "values": {
                "additionalProperties": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "map(string)"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "values": {
                "additionalProperties": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list(string)"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "values": {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "default": {
          "description": "The variable's default value in variables.tf (any JSON value, including null)."
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "description_ja": {
          "description": "Japanese translation of `description`, shown by the HTML viewer. Optional; the viewer falls back to `description` when absent.",
          "minLength": 1,
          "type": "string"
        },
        "group": {
          "description": "Display grouping used by the HTML viewer.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "Must match a variable name in variables.tf.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "type": {
          "description": "Terraform type of the variable.",
          "enum": [
            "string",
            "number",
            "bool",
            "map(string)",
            "list(string)",
            "any"
          ],
          "type": "string"
        },
        "values": {
          "additionalProperties": true,
          "description": "Per-environment overrides. Keys must be environment names from the top-level `environments` list; environments not listed here fall back to `default`. Value types are constrained per declared `type` by the allOf clauses below.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$",
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "name",
        "group",
        "type",
        "description",
        "default"
      ],
      "type": "object"
    }
  },
  "$id": "params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural contract for params.yaml. generate.py validates the sheet against this schema (via the Python jsonschema package when available, otherwise with equivalent built-in checks). Semantic rules a schema cannot express — parameter names matching variables.tf, no duplicate names — are enforced by generate.py itself.",
  "properties": {
    "environments": {
      "description": "Environment names, in display/generation order.",
      "items": {
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "groups": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "label_ja": {
            "description": "Japanese label for the group.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "label_ja"
        ],
        "type": "object"
      },
      "description": "Japanese display labels for the parameter groups, shown by the HTML viewer. Keys are the `group` values used by parameters.",
      "type": "object"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "environments",
    "parameters"
  ],
  "title": "params.yaml — SSOT parameter sheet",
  "type": "object"
}
